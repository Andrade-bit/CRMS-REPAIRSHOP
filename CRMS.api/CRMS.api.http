# Admin accounts for each tenant — companyId matches
# SELECT CompanyId, CompanyCode FROM dbo.Companies:
# 4 = TenantA, 5 = TenantB, 6 = TenantC

POST {{CRMS.api_HostAddress}}/api/auth/register-temp
Content-Type: application/json

{
  "username": "admin.tenanta",
  "password": "Admin123!",
  "fullName": "Tenant A Admin",
  "role": "Admin",
  "companyId": 4
}

