<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="SuperAdmin\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CRMS.api\CRMS.api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\edit.png">
      <LogicalName>CRMS.winforms.Icons.edit.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\archive.png">
      <LogicalName>CRMS.winforms.Icons.archive.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\approve.png">
      <LogicalName>CRMS.winforms.Icons.approve.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\lock.png">
      <LogicalName>CRMS.winforms.Icons.lock.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logo.png">
      <LogicalName>CRMS.winforms.Icons.logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>  